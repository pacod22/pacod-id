{
	"name": "@pacod/id-authz",
	"version": "0.1.0",
	"description": "The rules engine of pacod-id: product manifests, scopes, bindings and their evaluation.",
	"license": "Apache-2.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./yaml": {
			"types": "./dist/yaml.d.ts",
			"default": "./dist/yaml.js"
		},
		"./gen": {
			"types": "./dist/gen.d.ts",
			"default": "./dist/gen.js"
		},
		"./vectors": {
			"types": "./dist/vectors.d.ts",
			"default": "./dist/vectors.js"
		}
	},
	"bin": {
		"pacod-id-authz": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"yaml": "^2.9.1"
	}
}
