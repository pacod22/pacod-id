{
	"name": "@pacod/ui",
	"version": "0.1.0",
	"description": "Design tokens, brand themes and the sign-in and account components of the products that use pacod-id.",
	"license": "Apache-2.0",
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./tokens.css": "./dist/tokens.css",
		"./console.css": "./dist/console.css",
		"./tailwind.css": "./dist/tailwind.css"
	},
	"files": [
		"dist"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"build": "svelte-package -i src/lib -o dist && node scripts/build-tokens.js",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run"
	},
	"peerDependencies": {
		"svelte": "^5.40.0"
	},
	"devDependencies": {
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"vite": "^8.3.4"
	}
}
