{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"skipLibCheck": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"allowJs": true,
		"checkJs": false,
		"types": ["node"],
		"noEmit": true
	},
	"include": ["src", "scripts"]
}
